Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS and non-www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://perfectpixelpro.com/$1 [R=301,L]

  # Remove trailing slash (except real directories)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Old / duplicate URLs
  RewriteRule ^team/sahil$ /team [R=301,L]
  RewriteRule ^(articles|blog|blogs|neww-blog|neww-blog-page)$ /news [R=301,L]
  RewriteRule ^(why-choose-us|ai-is-a-tool-not-a-team|the-psychology-of-advertising|unlock-social-media-secrets)$ /blog/$1 [R=301,L]
  RewriteRule ^lets-talk$ /contact [R=301,L]

  # Serve real files as-is
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # App routes -> SPA
  RewriteRule ^(contact|work|news|career|team|about-us|life-at-ppp)$ /index.html [L]
  RewriteRule ^(work|news|blog|team)/[^/]+$ /index.html [L]
  RewriteRule ^articles/[0-9]+$ /index.html [L]

  # Everything else falls through to a real 404 (404.html)
</IfModule>
